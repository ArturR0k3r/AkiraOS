# ===== v2.0 Modular Architecture =====

menu "Display Drivers"

config AKIRA_SSD1306
    bool "Enable SSD1306 OLED display"
    default n
    depends on I2C
    help
      Enable SSD1306 128x64 OLED display driver.
      Used on Akira-Micro.

# ── Display panel ───────────────────────────────────────────────────────────
# Set CONFIG_DISPLAY=y plus ONE driver symbol in your board .conf:
#
#   CONFIG_DISPLAY=y
#   CONFIG_ST7789V=y              # Sitronix ST7789V 240×320 TFT (MIPI-DBI SPI)
#
#   CONFIG_DISPLAY=y
#   CONFIG_AKIRA_ILI9341_DRIVER=y # Ilitek ILI9341 240×320 TFT (Akira driver)
#
#   CONFIG_DISPLAY=y
#   CONFIG_LS0XX=y                # Sharp LS027B7DH01 400×240 Memory LCD
#
# For ST7789V: CONFIG_MIPI_DBI and CONFIG_MIPI_DBI_SPI auto-enable from DTS.
# For ILI9341: CMakeLists.txt appends boards/*_ili9341.overlay automatically.
# For Sharp:   CMakeLists.txt appends boards/*_sharp.overlay automatically.
# ────────────────────────────────────────────────────────────────────────────

# AKIRA_ILI9341_DRIVER is the selector for Akira's custom ILI9341 driver
# (no Zephyr upstream driver exists for this binding).
config AKIRA_ILI9341_DRIVER
    bool "ILI9341 TFT via Akira direct-SPI (240×320)"
    depends on DISPLAY && SPI
    help
      Ilitek ILI9341 240×320 colour TFT using Akira's custom SPI driver
      (akira,ili9341 binding).  CMakeLists.txt appends the board's
      *_ili9341.overlay and compiles src/drivers/display/akira_ili9341.c.

config FUEL_GAUGE_STC3115
    bool "STC3115 Li-Ion fuel gauge (AkiraConsole Prod)"
    default y
    depends on FUEL_GAUGE && I2C
    depends on DT_HAS_ST_STC3115_ENABLED
    help
      STMicroelectronics STC3115 coulomb-counting fuel gauge (U4, I2C 0x70)
      fitted on AkiraConsole Production.  Reports state of charge, battery
      voltage, current and temperature through Zephyr's fuel_gauge API, which
      akira_power_manager surfaces on the OS shell status bar.

config AKIRA_CRYPTO_ED25519_SELFTEST
    bool "Run the Ed25519/SHA-512 known-answer self-test at boot"
    default y
    help
      Validates the vendored SHA-512 + Ed25519 implementation against RFC 8032
      test vector 1 during boot (see the note in src/api/ed25519.c: mbedTLS's
      SHA-512 is unresolved on this target, so the vendored one is used).

      The implementation is static code — the result cannot change between
      boots of the same firmware — but the test costs ~8 s of CPU on the
      ESP32-S3 and that is paid on EVERY boot, including every wake from deep
      sleep, during which the console appears dead.

      Keep enabled for bring-up and when changing crypto code; disable on
      battery-powered builds once a firmware image has been validated.

config AKIRA_LP5817
    bool "LP5817 I2C backlight LED driver (AkiraConsole Prod)"
    depends on DISPLAY && I2C
    help
      TI LP5817 3-channel I2C LED driver (U7) sinking the panel backlight
      strings on AkiraConsole Production Rev A.3.  The board has no PWM
      backlight GPIO — the LP5817 at I2C 0x2D is the only way to light the
      panel, and it powers up fully disabled.  Without this the display
      initialises correctly but stays completely dark.

# Backward-compat aliases — C code and CMakeLists.txt reference these names.
config AKIRA_ST7789V_DRIVER
    bool
    default y if ST7789V

config AKIRA_SHARP_DISPLAY
    bool
    default y if LS0XX

  config AKIRA_SHARP_DISPLAY
      bool "Enable Sharp Memory LCD (LS027B7DH01)"
      default n
      depends on SPI && GPIO
      help
        Enable support for the Sharp LS027B7DH01 2.7" 400x240 Memory LCD.
        Activates the DTS overlay block that enables the ls027b7dh01 SPI node
        and overrides SCS chip-select polarity to ACTIVE_HIGH.
        Set CONFIG_LS0XX=y alongside this to enable the Zephyr display driver.

  config AKIRA_SHARP_INVERT_COLORS
      bool "Invert Sharp display colors (black↔white)"
      default n
      depends on AKIRA_SHARP_DISPLAY
      help
        XOR every packed MONO byte before sending to the Sharp LS0XX panel,
        swapping black and white. Applied in display_hal.c during RGB565→MONO
        conversion — no changes to the Zephyr driver required.

endmenu
menu "PSRAM / External RAM options"

config AKIRA_FONTS_IN_PSRAM
    bool "Place font data in PSRAM (if available)"
    default n
    depends on MEMC
    help
      When enabled, large font data (e.g., font11x18) will be placed in PSRAM
      (where supported by the board) instead of the default RO data section.

config AKIRA_FRAMEBUFFER_IN_PSRAM
    bool "Place framebuffer in PSRAM (if available)"
    default n
    depends on MEMC
    help
      When enabled, large framebuffer buffers used on hardware platforms
      will be allocated/placed in PSRAM if the underlying driver supports
      PSRAM placement. This is ignored on native_sim.

endmenu

config AKIRA_PSRAM
    bool "Enable Akira PSRAM helper APIs"
    default n
    depends on MEMC
    help
      Enable Akira PSRAM helper APIs which provide a thin wrapper for allocating
      large buffers in external PSRAM. This is used to place the WAMR heap and
      other large runtime buffers in external memory when available.

menu "RF Drivers"

config AKIRA_MODULE_RF
    bool "Enable Akira RF module"
    default n
    help
      Enable RF module (compile RF framework and drivers). Useful to disable on constrained boards.

config AKIRA_RF_FRAMEWORK
    bool "Enable unified RF framework"
    default n
    depends on AKIRA_MODULE_RF
    help
      Enable the unified RF driver framework that provides
      a common API for multiple RF chips.

config AKIRA_LR2021
    bool "Enable LR2021 LoRa Plus driver (AkiraConsole Production)"
    default n
    depends on SPI && GPIO && AKIRA_RADIO_MANAGER
    help
      Enable Semtech LR2021 LoRa Plus transceiver.
      Fourth-generation LoRa IP, multi-band Sub-GHz + 2.4 GHz.
      Supports LoRa, FSK, FLRC, BPSK, BLE PHY, O-QPSK modulations.
      Used on AkiraConsole Production via TCA6408 GPIO expander.

config AKIRA_CC1121
    bool "Enable CC1121 Sub-GHz driver (AkiraConsole Production)"
    default n
    depends on SPI && GPIO && AKIRA_RADIO_MANAGER && DT_HAS_TI_CC1121_ENABLED
    help
      Enable TI CC1121RHB high-performance Sub-GHz transceiver driver.
      Covers 315/433/868/915 MHz bands, narrowband FSK/OOK.
      Used on AkiraConsole Production via TCA6408 GPIO expander CS.
      Requires a DT node with compatible = "ti,cc1121" and status = "okay".

config AKIRA_RF_RX_DAEMON
    bool "Enable RF RX background daemon"
    default y
    depends on AKIRA_RF_FRAMEWORK
    help
      Runs a background thread that polls the active RF driver and enqueues
      received packets. Callers use akira_rf_recv_pop() instead of the
      blocking akira_rf_receive(). Enables non-blocking receive for WASM apps.

config AKIRA_RF_POLL_INTERVAL_MS
    int "RF RX daemon poll interval (ms)"
    default 2000
    depends on AKIRA_RF_RX_DAEMON
    help
      How long the daemon blocks in driver->rx() per poll cycle.
      Lower values reduce receive latency but increase CPU wakeups.

config AKIRA_RF_RX_QUEUE_DEPTH
    int "RF RX queue depth (packets)"
    default 8
    depends on AKIRA_RF_RX_DAEMON
    help
      Maximum number of received packets buffered before drop-oldest eviction.

config AKIRA_RF_DAEMON_STACK_SIZE
    int "RF RX daemon stack size (bytes)"
    default 4096
    depends on AKIRA_RF_RX_DAEMON

config AKIRA_RF_DAEMON_PRIORITY
    int "RF RX daemon thread priority"
    default 14
    depends on AKIRA_RF_RX_DAEMON

config AKIRA_RF_INSOMNIA_MAX_HOLD_S
    int "Maximum time a selected radio inhibits deep sleep (seconds)"
    default 3600
    range 60 86400
    depends on AKIRA_MODULE_RF
    help
      Selecting a radio takes a keep-awake lock, because deep sleep on this
      hardware is a power-off and would drop whatever the caller is listening
      for.  This bounds how long that lock survives if the caller never calls
      akira_rf_deinit()/akira_rf_release_all() — after it expires the device is
      free to auto-sleep again.  Set high enough to cover a legitimate long
      receive session.

endmenu

menu "Peripherals"

config CHARGER_BQ25601
    bool "Enable BQ25601 Li-Ion charger driver"
    default y if DT_HAS_TI_BQ25601_ENABLED
    depends on I2C && CHARGER
    help
      Enable TI BQ25601RTW Li-Ion battery charger driver.
      Implements the Zephyr charger API.
      Reports charge status, VBUS presence, faults.
      Allows setting charge current (0–3000 mA) and voltage (3840–4608 mV).


config FUEL_GAUGE_BQ28Z610
    bool "Enable BQ28Z610 fuel gauge driver"
    default y if DT_HAS_TI_BQ28Z610_ENABLED
    depends on I2C && FUEL_GAUGE
    help
      Enable TI BQ28Z610DRZ 1-cell Li-Ion fuel gauge + protection driver.
      Implements the Zephyr fuel_gauge API over I2C (SBS-compatible registers).
      Reports SoC, voltage, current, temperature, remaining/full capacity,
      time-to-empty, and cycle count.
config AKIRA_PWM_DIAL
    bool "Enable generic PWM-dial rotary input driver"
    default y if DT_HAS_AKIRA_PWM_DIAL_ENABLED
    depends on PWM && INPUT
    help
      Enable the akira,pwm-dial driver.  Reads the duty cycle of a
      potentiometer-based RC oscillator via MCPWM capture and reports
      INPUT_ABS_WHEEL (0-255) into the Zephyr input subsystem.
      On AkiraConsole Production: RK10J12R0A0B (RV1) on GPIO48.

config AKIRA_NFC_MANAGER
    bool "Enable NFC tag abstraction layer"
    default y if AKIRA_ST25DV
    help
      Hardware-agnostic registry for NFC tag chip drivers (mirrors
      AKIRA_RADIO_MANAGER for radios). Drivers register a read/write/UID/
      field-presence vtable at boot; callers go through the manager instead
      of a chip-specific API.

config AKIRA_NFC_MAX_DEVICES
    int "Maximum number of registered NFC devices"
    default 2
    depends on AKIRA_NFC_MANAGER
    help
      Size of the NFC device registry. Must be >= total number of NFC tag
      drivers enabled in this build.

config AKIRA_ST25DV
    bool "Enable ST25DV64K NFC tag driver"
    default y if DT_HAS_ST_ST25DV64K_ENABLED
    depends on I2C
    select AKIRA_NFC_MANAGER
    help
      Enable STMicroelectronics ST25DV64K Dynamic NFC/RFID tag driver.
      Provides I2C access to the 64 Kbit EEPROM user memory and system
      configuration registers. GPO interrupt for RF field / write events.
      RF operations (ISO 15693) happen autonomously when an NFC reader
      is present.

      Retained for boards that populate the ST25DV. AkiraConsole Prod Rev A.3
      replaced it with the SE050 (see AKIRA_SE050); its DT node is gone so this
      defaults off there, but the driver stays available.

config AKIRA_SE050
    bool "Enable NXP SE050 secure element driver"
    default y if DT_HAS_NXP_SE050_ENABLED
    depends on I2C
    select AKIRA_NFC_MANAGER
    help
      Enable the NXP EdgeLock SE050 Plug & Trust secure element driver.
      Talks to the SE050 over the ISO7816 T=1' block protocol tunnelled over
      I2C. Provides on-die true random, ECC P-256 key generation / signing
      (keys never leave the chip), and secure binary object storage.
      Owns the ENA GPIO for deep-sleep power gating.

      On AkiraConsole Production (Rev A.3) this is the SE050C1HQ1/Z01SCZ at
      I2C 0x48, replacing the Rev 1.2 ST25DV64K NFC tag.

if AKIRA_SE050

config AKIRA_SE050_SCP03
    bool "Use GlobalPlatform SCP03 authenticated/encrypted channel"
    default n
    help
      Wrap all APDU exchanges in a GlobalPlatform SCP03 secure channel
      (AES-CMAC + AES-CBC session keys). Requires the part's provisioned
      platform SCP03 static keys. Leave disabled to use a plain APDU session,
      which the SE050 permits for GetRandom, reading policy-open objects, and
      signing with objects whose policy allows unauthenticated use.

config AKIRA_SE050_SETTINGS_KEY
    bool "Back the NVS encryption key with the SE050"
    default n
    depends on AKIRA_SETTINGS_ENCRYPTION
    help
      Override akira_settings_get_encryption_key() to read the 32-byte
      AES-256 NVS key from an SE050 binary object instead of a compile-time
      constant. Provisioned from the SE050 TRNG on first boot if absent.

config AKIRA_SE050_SETTINGS_KEY_OBJID
    hex "SE050 object ID holding the NVS encryption key"
    default 0x50500001
    depends on AKIRA_SE050_SETTINGS_KEY
    help
      SE050 secure object identifier that stores the 32-byte NVS AES key.

config AKIRA_SE050_U2F
    bool "Expose SE050-backed (non-exportable) P-256 for U2F"
    default n
    depends on AKIRA_WASM_CRYPTO_ECDSA_P256
    help
      Add native P-256 keygen/sign that keep the private key on-die (the
      SE050 model — keys are non-exportable), for hardware-backed U2F/FIDO.
      The existing exportable soft-token P-256 API is left intact.

config AKIRA_SE050_U2F_KEY_OBJID
    hex "SE050 base object ID for U2F P-256 keys"
    default 0x50500010
    depends on AKIRA_SE050_U2F
    help
      Base SE050 secure object identifier for hardware-backed U2F key pairs.

endif # AKIRA_SE050

endmenu

