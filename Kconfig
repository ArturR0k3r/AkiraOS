# ---------------------------------------------------------------------------
# SD Card Hardware
# ---------------------------------------------------------------------------
menu "SD Card"

config AKIRA_SD_CARD
    bool "Enable SD card hardware support"
    default n
    select DISK_ACCESS
    select FAT_FILESYSTEM_ELM
    help
      Enables the SD card hardware driver (sd_card.c) which probes the disk
      and mounts FATFS at /SD: via SYS_INIT at CONFIG_AKIRA_SD_INIT_PRIORITY.

      The actual hardware interface (SPI-SDHC or native SDMMC) is selected
      by each board's .conf and .overlay files independently of this option.

      Enable per-board:
        CONFIG_SDHC=y
        CONFIG_DISK_DRIVER_SDHC=y     # SPI-based, most boards
        # or
        CONFIG_DISK_DRIVER_SDMMC=y    # native SDMMC peripheral

config AKIRA_SD_INIT_PRIORITY
    int "SD card SYS_INIT priority"
    default 38
    depends on AKIRA_SD_CARD
    help
      Automatic init priority for the SD card driver.  Must be lower than
      AKIRA_FS_INIT_PRIORITY (default 40) so the SD mount is complete before
      fs_manager queries disk availability.


config AKIRA_SD_HOTPLUG
    bool "Enable SD card hotplug detection via TCA6408 P7 I2C poll"
    default n
    depends on AKIRA_SD_CARD && GPIO
    help
      Polls TCA6408 P7 (SD_DET, active-low) via I2C at POLL_MS interval.
      Pure I2C — no SPI, no display impact (~100µs per check at 400kHz).
      Fires akira_sd_hotplug_cb_t callbacks on insertion/removal.

config AKIRA_SD_HOTPLUG_POLL_MS
    int "SD hotplug poll interval (ms)"
    default 2000
    depends on AKIRA_SD_HOTPLUG
    help
      Each poll is a real I2C read of the TCA6408 expander, so this rate is a
      standing power cost for the life of the device.  2 s is imperceptible for
      card insertion while keeping the wake rate low.  The poll is suspended
      entirely while the display is blanked (see akira_sd_card_hotplug_pause()).

config AKIRA_SD_HOTPLUG_MAX_CBS
    int "Maximum SD hotplug callbacks"
    default 4
    depends on AKIRA_SD_HOTPLUG

endmenu # SD Card

# ---------------------------------------------------------------------------
# USB Mass Storage
# ---------------------------------------------------------------------------
menu "USB Mass Storage"

config AKIRA_USB_MSC
    bool "Enable USB Mass Storage (SD card) device"
    default n
    depends on AKIRA_SD_CARD
    select USBD_MSC_CLASS
    help
      Exposes the SD card as a single USB MSC LUN to a host PC, gated by an
      on-device trust prompt and mutually exclusive with USB HID (keyboard,
      gamepad, FIDO2) — only one of the two can be registered on the USB
      device stack at a time.

config AKIRA_USB_MSC_WAIT_TIMEOUT_MS
    int "Timeout waiting for the SD card to free up before entering MSC mode"
    default 10000
    depends on AKIRA_USB_MSC
    help
      If a BLE/mesh/HTTP transfer or an SD-XIP app load is in progress when
      the user accepts the USB trust prompt, AkiraOS waits up to this long
      for it to finish before giving up and returning to idle.

config AKIRA_USB_MSC_SHIM_INIT_PRIORITY
    int "USB MSC ownership-shim disk SYS_INIT priority"
    default 39
    depends on AKIRA_USB_MSC
    help
      Must run after AKIRA_SD_INIT_PRIORITY (default 38) so the real "SD"
      disk is already registered when the shim wraps it. A plain literal —
      SYS_INIT's priority argument is token-pasted into a linker section
      name, so it cannot be an arithmetic expression like
      "AKIRA_SD_INIT_PRIORITY + 1".

endmenu # USB Mass Storage

# ---------------------------------------------------------------------------
# USB-C VBUS sense (FUSB302)
# ---------------------------------------------------------------------------
menu "USB-C VBUS Sense (FUSB302)"

config AKIRA_FUSB302_VBUS
    bool "Poll the FUSB302 PD controller for VBUS presence"
    default n
    depends on I2C
    help
      The ESP32-S3 dwc2 driver never reports real VBUS attach/remove
      events (VBUSVALID is hard-tied to a constant in the vendor quirk
      init), so this polls the FUSB302's own VBUS comparator
      (STATUS0.VBUSOK) over I2C instead — the real signal behind the USB
      trust-prompt flow in the OS shell.

config AKIRA_FUSB302_VBUS_INIT_PRIORITY
    int "FUSB302 VBUS-sense SYS_INIT priority"
    default 55
    depends on AKIRA_FUSB302_VBUS
    help
      A plain literal — SYS_INIT's priority argument is token-pasted into
      a linker section name, so it cannot be an arithmetic expression.

endmenu # USB-C VBUS Sense (FUSB302)

