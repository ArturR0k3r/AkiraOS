config AKIRA_SECURITY_AUDIT
    bool "Enable security audit logging"
    default y
    depends on AKIRA_CAPABILITY_SYSTEM
    help
      Enable ring buffer security audit log that records
      denied capabilities, rate limits, and watchdog kills.

config AKIRA_AUDIT_LOG_SIZE
    int "Audit log entries"
    default 32
    range 16 128
    depends on AKIRA_SECURITY_AUDIT
    help
      Number of audit log entries in the ring buffer.
      Each entry uses ~100 bytes of RAM (includes 32-byte HMAC field).

config AKIRA_PLATFORM_AUDIT_HMAC
    bool "Platform HMAC key provider for audit log"
    default n
    help
      Indicates that the platform layer provides akira_platform_audit_hmac_sign().
      Set this in board-specific or application-specific Kconfig when a concrete
      implementation (HSM, mbedTLS stub, etc.) is available.

config AKIRA_AUDIT_LOG_HMAC
    bool "HMAC-SHA256 signing of audit log entries"
    default n
    depends on AKIRA_SECURITY_AUDIT
    depends on AKIRA_PLATFORM_AUDIT_HMAC
    help
      Tag each audit log entry with HMAC-SHA256 keyed from HSM slot
      AKIRA_HSM_SLOT_AUDIT_KEY.  The 32-byte tag enables AkiraHub to
      verify that entries were authentically produced by this device,
      closing the PSA Certified L1 non-repudiation gap (IEC 62443-4-2 SL2).

      Requires akira_platform_audit_hmac_init() to be called at boot.

config AKIRA_SANDBOX_MPU
    bool "Hardware MPU isolation per WASM sandbox"
    default n
    depends on AKIRA_SANDBOX
    depends on ARM_MPU
    select USERSPACE
    help
      Configure an ARM MPU domain for each WASM app's linear memory.
      The domain is activated on sandbox_exec_begin() and deactivated on
      sandbox_exec_end(), so out-of-bounds native memory accesses during
      WASM interpretation are caught by the hardware rather than silently
      corrupting kernel state.

      The WASM runtime must call sandbox_mpu_configure() after loading
      the module to register the linear memory base and size.

      Requires CONFIG_USERSPACE=y (selected automatically) and
      CONFIG_ARM_MPU=y on the target board.

config AKIRA_WASM_INTEGRITY_CHECK
    bool "Enable WASM binary integrity verification"
    default y
    depends on AKIRA_CAPABILITY_SYSTEM
    help
      Verify WASM binary structural integrity (magic, version,
      section layout) before loading. Catches corrupted binaries.

config AKIRA_MODULE_CACHE
    bool "Enable WASM module cache"
    default y
    depends on AKIRA_WASM_RUNTIME
    help
      Cache loaded WASM modules by SHA-256 hash to avoid
      reloading identical binaries. Trades RAM for performance.

config AKIRA_MODULE_CACHE_SIZE
    int "Module cache entries"
    default 4
    range 2 8
    depends on AKIRA_MODULE_CACHE
    help
      Maximum number of cached WASM modules.
      Each cached module retains the parsed WAMR module in memory.

