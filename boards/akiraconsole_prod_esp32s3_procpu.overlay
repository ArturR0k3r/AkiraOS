// SPDX-License-Identifier: Apache-2.0
// AkiraConsole Production — application-level overlay.
// Board hardware (pins, buses, peripherals) defined in boards/akiraconsole_prod/*.dts
// This file enables peripherals for the app build and adds display/USB config.

#include <zephyr/dt-bindings/gpio/gpio.h>

// =============================================================================
// PSRAM
// =============================================================================
&psram0 {
	size   = <DT_SIZE_M(8)>;
	status = "okay";
};

// =============================================================================
// CPU clock — battery-life A/B knob
// =============================================================================
// Uncomment to run the CPU at 160 MHz instead of the SoC default 240 MHz.
// Dynamic CPU power scales roughly with clock, and much of this firmware's busy
// time is PSRAM-bound rather than clock-bound, so the wall-clock cost is
// expected to be well under the 1.5x the ratio suggests — measure it with
// `power stats` before and after.
//
// Safe because CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC and CONFIG_XTENSA_CCOUNT_HZ
// are derived from this property (soc/espressif/common/Kconfig.defconfig), MSPI
// timing is tuned at boot for the actual clock, and APB stays at 80 MHz on a
// 160 MHz PLL source — so 40 MHz DIO flash and the octal PSRAM are unaffected.
//
// Left disabled by default because it shifts timing for everything the console
// talks to.  Before enabling, re-test: WASM AOT app performance, the SPI display
// and SD card, USB HID enumeration, and the BT controller.
//
// Do NOT try 80 MHz: that changes the CPU clock *source* and takes APB with it,
// which re-divides SPI2, I2C and the UART baud generator.
//
// Runtime scaling (DFS) is not an option here — CCOUNT_HZ is a compile-time
// constant, so changing the clock at runtime would corrupt every k_sleep(),
// k_busy_wait() and tick accounting in the system.
//
// Verified to build and to correctly derive CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC
// and CONFIG_XTENSA_CCOUNT_HZ = 160000000; not yet validated on hardware.
// &cpu0 { clock-frequency = <DT_FREQ_M(160)>; };

// =============================================================================
// Watchdog
// =============================================================================
&wdt0 { status = "okay"; };

// =============================================================================
// GPIO / WiFi / UART — safe for both app and MCUboot
// =============================================================================
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&wifi  { status = "okay"; };
&uart0 { status = "okay"; current-speed = <115200>; };

// =============================================================================
// SPI2 — no cs-gpios override needed for ST7789V or ILI9341 modes.
// Sharp LCD (J4) override: set CONFIG_AKIRA_SHARP_DISPLAY=y — see below.
// =============================================================================
// =============================================================================
// I2C — TCA6408 (pca9538) and BME280 disabled in board DTS for MCUboot.
// Enabled here for app build only.
// =============================================================================
#ifndef CONFIG_MCUBOOT
&i2c0 { status = "okay"; };

&tca6408 {
	status = "okay";
	/delete-property/ int-gpios;
};
&bme280  { status = "okay"; };  // bosch,bme280 (I2C addr 0x77)

// cc1121.c driver uses GPIO_DT_SPEC_GET(CC1121_NODE, cs_gpios) — add cs-gpios to the node
&cc1121 {
	cs-gpios = <&tca6408 3 GPIO_ACTIVE_LOW>;  // CC_CS → TCA6408 P3
};

// Rev A.3: SE050 populated, replacing the Rev 1.2 ST25DV64K NFC tag (no
// st25dv node on this revision). se050 node status="okay" in the base DTS —
// no override needed here.

// TS3USB221 (U21) USB data mux select. Per the KiCad-netlist-verified TCA6408
// pin map (board DTS): P0 = USB_SEL. Drive it at boot to route the USB-C J2
// D+/D- pair to the ESP32-S3 native USB-OTG controller (GPIO19/20) that carries
// the WebHID interface — without this the host never sees the HID device.
// usb_manager_enable() drives this via GPIO_DT_SPEC_GET(zephyr_user, ...).
// VERIFY polarity on hardware: if HID still does not enumerate, flip the flag
// here between GPIO_ACTIVE_HIGH and GPIO_ACTIVE_LOW.
/ {
	zephyr,user {
		usb-mux-sel-gpios = <&tca6408 0 GPIO_ACTIVE_LOW>;  // USB_SEL → TCA6408 P0
	};
};

#endif /* !CONFIG_MCUBOOT */

// =============================================================================
// ADC alias
// =============================================================================
/ {
	aliases {
		akira-adc = &adc1;
	};
};

// =============================================================================
// Display
// Default : ST7789V via MIPI-DBI (board DTS default, no overlay changes needed).
// ILI9341 : set CONFIG_AKIRA_ILI9341_DRIVER=y in the board .conf —
//           CMakeLists.txt appends boards/akiraconsole_prod/*_ili9341.overlay.
// Sharp   : set CONFIG_AKIRA_SHARP_DISPLAY=y in the board .conf —
//           CMakeLists.txt appends boards/akiraconsole_prod/*_sharp.overlay.
// =============================================================================

// =============================================================================
// USB Device — HID interface
// =============================================================================
&zephyr_udc0 {
	status = "okay";  // HID interface only, no CDC ACM console

	hid_dev_0: hid_dev_0 {
		compatible            = "zephyr,hid-device";
		protocol-code         = "none";
		in-polling-period-us  = <1000>;
		out-polling-period-us = <1000>;
		in-report-size        = <64>;
		out-report-size       = <64>;
	};

	/* FIDO2/CTAP2 authenticator — dedicated interface, no Report ID.
	 * CTAPHID requires exactly 64-byte packets; a shared Report-ID'd
	 * interface would need 65 bytes (1 ID + 64 payload), which exceeds
	 * the 64-byte hard cap for full-speed USB interrupt endpoints. */
	hid_dev_1: hid_dev_1 {
		compatible            = "zephyr,hid-device";
		protocol-code         = "none";
		in-polling-period-us  = <1000>;
		out-polling-period-us = <1000>;
		in-report-size        = <64>;
		out-report-size       = <64>;
	};
};

// =============================================================================
// Flash partition layout — 16MB
//
//   0x000000–0x3FFFFF  MCUboot + slot0 + slot1
//                      (boards/akiraconsole_prod/akiraconsole_prod_partitions_16M.dtsi)
//   0x400000–0x407FFF  NVS settings 32KB   ← BT bonds, Wi-Fi credentials
//   0x408000–0x487FFF  LittleFS 512KB       ← app filesystem
//
// Partitions start at 0x400000 so OTA (slot1 at 0x210000–0x3FFFFF) never
// overwrites user data. The slots are sized to end exactly at 0x400000, so
// growing them means moving these — and orphaning existing user data.
// =============================================================================
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells    = <1>;

		akira_settings_nvs_partition: partition@400000 {
			label = "akira_settings_nvs";
			reg   = <0x00400000 DT_SIZE_K(32)>;
		};

		lfs1_partition: partition@408000 {
			label = "lfs_storage";
			reg   = <0x00408000 DT_SIZE_K(512)>;
		};

		/* Hub credentials NVS — device_id + auth token
			* 2 × 4 KB sectors; placed after LittleFS well within 16 MB flash. */
		hub_nvs_partition: partition@488000 {
				label = "hub_nvs";
				reg   = <0x00488000 DT_SIZE_K(8)>;
		};
	};
};

/ {
	chosen {
		zephyr,settings-partition = &akira_settings_nvs_partition;
	};

	fstab {
		compatible = "zephyr,fstab";

		lfs1: lfs1 {
			compatible     = "zephyr,fstab,littlefs";
			read-size      = <1>;
			prog-size      = <16>;
			cache-size     = <256>;
			lookahead-size = <32>;
			block-cycles   = <512>;
			partition      = <&lfs1_partition>;
			mount-point    = "/lfs";
		};
	};
};
